# Copy to .env and fill in:  cp .env.example .env

# The subdomain that points to the server (DNS A record → server IP)
DOMAIN=oop.yamenrock.com

# Teacher/admin Google emails, comma separated
ADMIN_EMAILS=your.name@gmail.com

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secrets. Generate each with:  openssl rand -base64 32
NEXTAUTH_SECRET=
POSTGRES_PASSWORD=

# Only for local development (npm run dev). Docker Compose builds these itself.
# DATABASE_URL=postgres://oop:oop@localhost:5432/oop
# NEXTAUTH_URL=http://localhost:3000
